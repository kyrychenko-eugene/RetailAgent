# Copy this file to .env and fill in your values. Never commit .env.

# Gemini API key from Google AI Studio (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your-gemini-api-key

# GCP project that runs (and is billed for) BigQuery query jobs.
# Authenticate first with: gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Model profile: "standard" (Flash for analysis) or "free" (Flash-Lite only; recommended on free-tier keys)
LLM_PROFILE=free

# Optional: fallback provider, used only when set
# ANTHROPIC_API_KEY=
